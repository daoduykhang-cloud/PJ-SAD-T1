<mxfile host="app.diagrams.net"><diagram id="arch4" name="Kien truc he thong"><mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="940" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" value="&lt;b&gt;Web khách hàng&lt;/b&gt;&lt;br&gt;Responsive: máy tính, di động&lt;br&gt;Chọn bàn trên sơ đồ" vertex="1"><mxGeometry x="40" y="30" width="300" height="60" as="geometry" /></mxCell><mxCell id="b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" value="&lt;b&gt;Cổng nhà hàng&lt;/b&gt;&lt;br&gt;Quản lý, nhân viên (gọi xác nhận, check-in)" vertex="1"><mxGeometry x="370" y="30" width="300" height="60" as="geometry" /></mxCell><mxCell id="b3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" value="&lt;b&gt;Cổng quản trị&lt;/b&gt;&lt;br&gt;Quản trị viên nền tảng" vertex="1"><mxGeometry x="700" y="30" width="340" height="60" as="geometry" /></mxCell><mxCell id="b4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;Xác thực, Phân quyền, Giới hạn tốc độ (Rate Limiting), Định tuyến,&lt;br&gt;Kiểm tra yêu cầu (Request Validation), Ghi log API (API Logging)" vertex="1"><mxGeometry x="40" y="140" width="1000" height="70" as="geometry" /></mxCell><mxCell id="b5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=11;" value="&lt;b&gt;Xác thực &amp; Người dùng&lt;/b&gt;&lt;br&gt;• Tài khoản&lt;br&gt;• Vai trò &amp; phân quyền&lt;br&gt;• Xác thực&lt;br&gt;• JWT" vertex="1"><mxGeometry x="40" y="254" width="180" height="300" as="geometry" /></mxCell><mxCell id="b6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=11;" value="&lt;b&gt;Quản lý nhà hàng&lt;/b&gt;&lt;br&gt;• Hồ sơ nhà hàng&lt;br&gt;• Tìm kiếm &amp; bộ lọc&lt;br&gt;• Thực đơn &amp; Món ăn&lt;br&gt;• Giờ mở cửa&lt;br&gt;• Hình ảnh nhà hàng&lt;br&gt;• Danh mục ẩm thực&lt;br&gt;• Đánh giá &amp; kiểm duyệt" vertex="1"><mxGeometry x="240" y="254" width="200" height="300" as="geometry" /></mxCell><mxCell id="b7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=11;" value="&lt;b&gt;Đặt bàn &amp; Quản lý bàn&lt;/b&gt;&lt;br&gt;• Sơ đồ bàn thời gian thực&lt;br&gt;• Chọn bàn cụ thể trên sơ đồ&lt;br&gt;• Kiểm tra bàn trống&lt;br&gt;• Khóa bàn tạm thời&lt;br&gt;• Tạo yêu cầu đặt bàn&lt;br&gt;• Xác nhận / Từ chối đặt bàn&lt;br&gt;• Sửa / Hủy đặt bàn&lt;br&gt;• QR Code &amp; Check-in&lt;br&gt;• Quản lý khách không đến (no-show)&lt;br&gt;&lt;br&gt;&lt;b&gt;Kiểm soát đặt trùng bàn&lt;/b&gt;&lt;br&gt;– Kiểm tra bàn theo ngày, giờ và thời lượng đặt&lt;br&gt;– Ngăn hai yêu cầu đặt cùng bàn trong khoảng thời gian trùng&lt;br&gt;– Khóa bàn tạm thời khi khách đang thao tác&lt;br&gt;– Giải phóng khóa khi hết thời gian hoặc khách không hoàn tất" vertex="1"><mxGeometry x="460" y="254" width="380" height="300" as="geometry" /></mxCell><mxCell id="b8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=11;" value="&lt;b&gt;Thanh toán &amp; Thông báo&lt;/b&gt;&lt;br&gt;• Đặt cọc &amp; thanh toán&lt;br&gt;• Xử lý hoàn tiền&lt;br&gt;• Thông báo đặt bàn&lt;br&gt;• Nhắc lịch&lt;br&gt;• Xác nhận đặt bàn" vertex="1"><mxGeometry x="860" y="254" width="180" height="300" as="geometry" /></mxCell><mxCell id="c9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;" value="Tầng dữ liệu (Data Layer)" vertex="1"><mxGeometry x="40" y="600" width="1000" height="150" as="geometry" /></mxCell><mxCell id="b10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Lưu dữ liệu tài khoản, nhà hàng, bàn ăn, món ăn, đặt bàn, thanh toán, đánh giá, nhật ký hệ thống" vertex="1"><mxGeometry x="60" y="640" width="225" height="92" as="geometry" /></mxCell><mxCell id="b11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;Cache và khóa bàn tạm thời" vertex="1"><mxGeometry x="305" y="640" width="225" height="92" as="geometry" /></mxCell><mxCell id="b12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;Hàng đợi xử lý thông báo (SMS / Email)" vertex="1"><mxGeometry x="550" y="640" width="225" height="92" as="geometry" /></mxCell><mxCell id="b13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" value="&lt;b&gt;Object Storage&lt;/b&gt;&lt;br&gt;Lưu hình ảnh nhà hàng" vertex="1"><mxGeometry x="795" y="640" width="225" height="92" as="geometry" /></mxCell><mxCell id="b14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;dashed=1;" value="&lt;b&gt;SMS Gateway&lt;/b&g